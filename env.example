# StyleSnap Environment Variables
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Edge Function for Real-time User Sync
# This function handles user creation synchronization
VITE_SUPABASE_SYNC_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/sync-auth-users-realtime

# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Optional: Cloudinary API Key and Secret (for server-side operations)
# CLOUDINARY_API_KEY=your_api_key_here
# CLOUDINARY_API_SECRET=your_api_secret_here

# Hugging Face API Configuration
# Get your free API token from: https://huggingface.co/settings/tokens
# Required for:
#   - AI Clothing Description feature (Llama-4-Scout model)
VITE_HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here

# Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/
# Required for:
#   - Virtual Try-On feature (Imagen 4.0 model)
# NOTE: Use GEMINI_API_KEY (without VITE_ prefix) in Vercel for server-side security
# The service uses a proxy endpoint to keep the key secure
GEMINI_API_KEY=your_gemini_api_key_here

# Brevo (Sendinblue) Transactional Email API Key (server-side only)
# Set this in deployment environment variables; do not prefix with VITE_
# BREVO_API_KEY=your_brevo_api_key_here

# Supabase server-side (for email status + idempotency in API)
# If SUPABASE_URL is not set, the server will reuse VITE_SUPABASE_URL
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
